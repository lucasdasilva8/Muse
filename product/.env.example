# Muse product — prototype environment
# Not fully functioning (no payments / real auth / legal offering).

MUSE_PROTOTYPE=true

# Set on Vercel (or any host) so the app knows filesystem DB is unavailable
# MUSE_HOSTED=true

# Required for experimental public deploy (shared persistence):
# 1. Create a Supabase project
# 2. Run supabase/schema.sql in the SQL editor
# 3. Create Storage bucket: muse-docs
# 4. Fill these in (Vercel → Environment Variables, or .env.local)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
