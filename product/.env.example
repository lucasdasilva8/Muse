# Muse product — prototype environment
# Not fully functioning (no payments / real auth / legal offering).

MUSE_PROTOTYPE=true

# Optional: wire Supabase (leave blank to use local .data/muse.json)
# 1. Create a Supabase project
# 2. Run supabase/schema.sql in the SQL editor
# 3. Create Storage bucket: muse-docs
# 4. Fill these in and restart `npm run dev`

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
